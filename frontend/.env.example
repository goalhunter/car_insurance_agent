# Frontend Environment Variables
# Copy this file to .env and update with your actual API URLs

# Base URL for the API Gateway / Lambda Function URL
# This will be automatically set by deploy_frontend.py after deployment
VITE_API_BASE_URL=https://your-api-url-here.execute-api.us-east-1.amazonaws.com/Prod

# Upload API URL (usually the same as API_BASE_URL)
VITE_UPLOAD_API_URL=https://your-api-url-here.execute-api.us-east-1.amazonaws.com/Prod
